EXCHANGE=binance
SYMBOL=BTCUSDC
SYMBOLS=BTCUSDT,BTCUSDC
MARKET_TYPE=perpetual
DATA_DIRECTORY=./data
LOG_LEVEL=INFO
TRADING_ENABLED=false

# Public Binance USD-M Futures endpoints. These are configurable for tests
# and future testnet use; Phase 1 never calls authenticated endpoints.
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com
WS_STALE_AFTER_SECONDS=5.0
WS_RECONNECT_INITIAL_SECONDS=1.0
WS_RECONNECT_MAX_SECONDS=30.0

# Capture retains all known L2 levels; a hard cap triggers resync, never pruning.
# MAX_STORED_LEVELS is a legacy API option, not used by the capture runtime.
ORDERBOOK_STALE_AFTER_MS=3000
ORDERBOOK_MAX_BUFFERED_EVENTS=50000
ORDERBOOK_MAX_STORED_LEVELS=
ORDERBOOK_HARD_LEVEL_LIMIT=100000
ORDERBOOK_RESYNC_INITIAL_SECONDS=0.5
ORDERBOOK_RESYNC_MAX_SECONDS=10.0

# Feature and clock synchronization settings.
FEATURE_INTERVAL_MS=100
TRADE_STALE_AFTER_MS=5000
CLOCK_SYNC_INTERVAL_SECONDS=300
CLOCK_SYNC_SAMPLE_COUNT=5
CLOCK_SYNC_MAX_RTT_MS=1000
MID_HISTORY_SECONDS=15
TRADE_HISTORY_SECONDS=15
FEATURE_IMBALANCE_LEVELS=1,5,10
FEATURE_RECORDER_BATCH_SIZE=6000
FEATURE_RECORDER_FLUSH_INTERVAL_SECONDS=60.0
FEATURE_RECORDER_QUEUE_SIZE=10000
RAW_RECORDER_BATCH_SIZE=20000
RAW_RECORDER_FLUSH_INTERVAL_SECONDS=30.0
RAW_RECORDER_QUEUE_SIZE=100000

# Queue WARNING >= 70%, CRITICAL >= 90%; critical/disk failure invalidates session.
MIN_FREE_DISK_GB=2
HEALTH_REPORT_INTERVAL_SECONDS=60
# Empty means continuous. SIGINT/SIGTERM perform graceful finalization.
CAPTURE_DURATION_SECONDS=
